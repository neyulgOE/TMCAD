{
  "schema_version": 2,
  "model_id": "pallet_v3",
  "model_name": "Pallet Detector V3",
  "version": "v3",
  "task_type": "bbox",
  "object_type": "pallet",
  "adapter": "dfl_multiscale_class_scores_v1",
  "preprocess": {
    "type": "letterbox",
    "mean": [0, 0, 0],
    "std": [255, 255, 255],
    "padding_value": 114,
    "keep_aspect_ratio": true
  },
  "output": {
    "type": "dfl_multiscale_class_scores_v1",
    "num_classes": 2,
    "reg_max": 16,
    "strides": [8, 16, 32],
    "class_scores_activated": true
  },
  "labels": "labels.txt",
  "metadata": {
    "runtime_role": "pallet_detection",
    "representation": "block_front"
  },
  "artifacts": {
    "profiles": {
      "orangepi5b_rk3588": {
        "backend": "rknn",
        "target_platform": "rk3588",
        "default": "int8",
        "variants": {
          "int8": "artifacts/orangepi5b_rk3588/model.rknn"
        },
        "input": {
          "width": 640,
          "height": 640,
          "channels": 3,
          "format": "RGB",
          "layout": "NHWC",
          "type": "uint8"
        }
      }
    }
  }
}
